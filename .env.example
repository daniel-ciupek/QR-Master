# ============================================================
# APPLICATION
# ============================================================
APP_NAME="QR-Master"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Warsaw

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ============================================================
# LOGGING
# ============================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# DATABASE — PostgreSQL 17
# ============================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qrmaster
DB_USERNAME=qrmaster
DB_PASSWORD=

# ============================================================
# CACHE & SESSION — Redis
# ============================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=qrmaster_

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# ============================================================
# QUEUE — Redis + Horizon
# ============================================================
QUEUE_CONNECTION=redis

HORIZON_PREFIX=qrmaster_horizon:
HORIZON_BALANCE=auto
HORIZON_MAX_PROCESSES=20
HORIZON_MEMORY_LIMIT=128

# ============================================================
# FILESYSTEM — Cloudflare R2 (S3-compatible)
# ============================================================
FILESYSTEM_DISK=local

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_URL=

# AWS (fallback / backup storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================
# MAIL — Mailpit (dev) / SES / SMTP (prod)
# ============================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@qr-master.app"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# BROADCASTING — Laravel Reverb (WebSocket)
# ============================================================
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ============================================================
# OCTANE — FrankenPHP
# ============================================================
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
OCTANE_WORKERS=auto
OCTANE_TASK_WORKERS=auto
OCTANE_MAX_REQUESTS=500

# ============================================================
# SEARCH — Typesense (Laravel Scout)
# ============================================================
SCOUT_DRIVER=typesense
SCOUT_QUEUE=true

TYPESENSE_API_KEY=
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# ============================================================
# STRIPE — Laravel Cashier
# ============================================================
STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
CASHIER_CURRENCY=pln
CASHIER_CURRENCY_LOCALE=pl_PL
CASHIER_LOGGER=daily

# Stripe Price IDs (from Stripe Dashboard → Products)
STRIPE_PRICE_PRO=price_
STRIPE_PRICE_BUSINESS=price_
STRIPE_PRICE_ENTERPRISE=price_

# Stripe Tax — requires activation in Stripe Dashboard → Tax → Enable
# automatic_tax + tax_id_collection enabled in SubscribeController

# ============================================================
# SENTRY — Error tracking (PII filter enabled)
# ============================================================
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT="${APP_ENV}"

# ============================================================
# CLOUDFLARE — Turnstile (captcha) + WAF
# ============================================================
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY="${CLOUDFLARE_TURNSTILE_SITE_KEY}"

# ============================================================
# AUTH — Fortify / Sanctum / WebAuthn
# ============================================================
FORTIFY_PREFIX=
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# WebAuthn (laragear/webauthn)
WEBAUTHN_RELYING_PARTY_NAME="${APP_NAME}"
WEBAUTHN_RELYING_PARTY_ID=localhost

# ============================================================
# FILAMENT — Admin panel (/admin)
# ============================================================
FILAMENT_DOMAIN=
FILAMENT_PATH=admin

# ============================================================
# GEOLOCATION — stevebauman/location
# ============================================================
LOCATION_DRIVER=ipapi
LOCATION_CACHE_DRIVER=redis
LOCATION_CACHE_EXPIRES=1440

# ============================================================
# QR-MASTER — app-specific
# ============================================================
QR_SHORT_HASH_LENGTH=8
QR_DEFAULT_ERROR_CORRECTION=H
QR_MAX_LOGO_SIZE_PERCENT=30
QR_EXPORT_MAX_RESOLUTION=4096

# Scan IP hash salt (random 64-char string, NOT reusable across envs)
SCAN_IP_HASH_SALT=

# ============================================================
# AI — prism-php/prism (obsługuje DeepSeek, Anthropic, OpenAI, Gemini, Ollama...)
# ============================================================

# --- Opcja 1: DeepSeek (DOMYŚLNY — tani, bez vision) ---
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-twój-klucz-deepseek
AI_FAST_MODEL=deepseek-chat
AI_SMART_MODEL=deepseek-chat
AI_VISION_ENABLED=false

# --- Opcja 2: Anthropic Claude (vision + najlepsza jakość) ---
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-twój-klucz
# ANTHROPIC_API_VERSION=2023-06-01
# AI_FAST_MODEL=claude-haiku-4-5
# AI_SMART_MODEL=claude-sonnet-4-5
# AI_VISION_ENABLED=true

# --- Opcja 3: OpenAI (vision obsługiwane) ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-twój-klucz-openai
# AI_FAST_MODEL=gpt-4o-mini
# AI_SMART_MODEL=gpt-4o
# AI_VISION_ENABLED=true

# --- Wspólne ustawienia ---
# Monthly AI request limits per plan (0 = disabled for Free)
AI_RATE_LIMIT_FREE=0
AI_RATE_LIMIT_PRO=50
AI_RATE_LIMIT_BUSINESS=500
# Cache TTL in seconds for AI responses (default 24h)
AI_CACHE_TTL=86400

# ============================================================
# VITE — Frontend
# ============================================================
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
